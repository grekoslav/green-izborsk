---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import About from '../components/About.astro';
import HowToOrder from '../components/HowToOrder.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import companyData from '../data/company.json';
import { fetchProductsFromGoogleSheets } from '../utils/googleSheets';

const productsData = await fetchProductsFromGoogleSheets(companyData.googleSheetUrl);

// Из строки «от 250 ₽/кг» достаём число 250 для разметки Offer
const parsePrice = (price: string): number | null => {
  const m = price.replace(/\s/g, '').match(/\d+(?:[.,]\d+)?/);
  return m ? Number(m[0].replace(',', '.')) : null;
};

const siteURL = new URL('/', Astro.site).href;

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Каталог продукции фермы «Зелёный Изборск»',
  'itemListElement': productsData.map((product, index) => {
    const price = parsePrice(product.price);
    return {
      '@type': 'ListItem',
      'position': index + 1,
      'item': {
        '@type': 'Product',
        'name': product.name,
        'description': product.description || product.name,
        'image': new URL(product.image, siteURL).href,
        'category': product.category,
        // Offer без цены — ошибка валидации, поэтому добавляем его только если цена указана
        ...(price !== null && {
          'offers': {
            '@type': 'Offer',
            'price': price,
            'priceCurrency': 'RUB',
            'availability': product.inStock
              ? 'https://schema.org/InStock'
              : 'https://schema.org/PreOrder',
            'seller': { '@id': `${siteURL}#business` }
          }
        })
      }
    };
  })
};
---

<Layout
  title={`Фермерские продукты в Пскове с доставкой — ${companyData.name}`}
  description="Свежие фермерские овощи, зелень, ягоды и мёд с семейной фермы в Изборске. Доставка по Пскову и области, самовывоз с фермы. Актуальное наличие и цены на сайте."
  jsonLd={catalogSchema}
>
  <Header />
  
  <main>
    <Hero />
    
    <!-- Catalog -->
    <section id="catalog" class="catalog section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">С нашего поля</span>
          <h2 class="section-title">Наша продукция</h2>
          <div class="divider"><span class="divider-icon">🌿</span></div>
          <p class="section-subtitle">
            Всё, что мы выращиваем — свежее, вкусное и с любовью. 
            Выберите продукт и оставьте заявку — мы всё обсудим лично.
          </p>
        </div>
        
        <div class="products-grid">
          {productsData.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>

        <div class="catalog-note">
          <p>
            <strong>💡 Это не интернет-магазин.</strong> Мы не берём оплату на сайте. 
            Чтобы заказать — позвоните нам или оставьте заявку, и мы свяжемся с вами лично.
          </p>
        </div>
      </div>
    </section>

    <!-- About -->
    <About />

    <!-- How to Order -->
    <HowToOrder />
  </main>
  
  <Footer />
  <LeadForm />
</Layout>

<style>
  .catalog {
    background-color: var(--color-surface-alt);
  }

  .products-grid {
    display: grid;
    gap: var(--spacing-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .catalog-note {
    margin-top: var(--spacing-2xl);
    text-align: center;
  }

  .catalog-note p {
    display: inline-block;
    max-width: 560px;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .catalog-note strong {
    color: var(--color-text);
  }
</style>
