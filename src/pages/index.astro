---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import About from '../components/About.astro';
import HowToOrder from '../components/HowToOrder.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import productsData from '../data/products.json';
---

<Layout>
  <Header />
  
  <main>
    <Hero />
    
    <!-- Catalog -->
    <section id="catalog" class="catalog section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">С нашего поля</span>
          <h2 class="section-title">Наша продукция</h2>
          <div class="divider"><span class="divider-icon">🌿</span></div>
          <p class="section-subtitle">
            Всё, что мы выращиваем — свежее, натуральное и без химии. 
            Выберите продукт и оставьте заявку — мы всё обсудим лично.
          </p>
        </div>
        
        <div class="products-grid">
          {productsData.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>

        <div class="catalog-note">
          <p>
            <strong>💡 Это не интернет-магазин.</strong> Мы не берём оплату на сайте. 
            Чтобы заказать — позвоните нам или оставьте заявку, и мы свяжемся с вами лично.
          </p>
        </div>
      </div>
    </section>

    <!-- About -->
    <About />

    <!-- How to Order -->
    <HowToOrder />
  </main>
  
  <Footer />
  <LeadForm />
</Layout>

<style>
  .catalog {
    background-color: var(--color-surface-alt);
  }

  .products-grid {
    display: grid;
    gap: var(--spacing-lg);
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .catalog-note {
    margin-top: var(--spacing-2xl);
    text-align: center;
  }

  .catalog-note p {
    display: inline-block;
    max-width: 560px;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .catalog-note strong {
    color: var(--color-text);
  }
</style>
