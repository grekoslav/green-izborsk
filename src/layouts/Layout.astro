---
import "../styles/global.css";
import { Font } from "astro:assets";
import SEO, { type Props as SEOProps } from "../components/SEO.astro";

interface Props extends SEOProps {}

const { ...seoProps } = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <Font cssVariable="--font-playfair" preload={[{ subset: "cyrillic", style: "normal" }]} />
        <Font cssVariable="--font-source-sans" preload={[{ subset: "cyrillic", style: "normal" }]} />
        <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
        <SEO {...seoProps} />
    </head>
    <body>
        <slot />
    </body>
</html>
