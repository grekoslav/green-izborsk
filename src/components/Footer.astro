---
import companyData from '../data/company.json';

const base = import.meta.env.BASE_URL;
---

<footer id="contacts" class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={base} class="footer-logo">
          <span class="footer-logo-leaf">🌿</span>
          <span class="footer-logo-text">{companyData.name}</span>
        </a>
        <p class="footer-description">{companyData.description}</p>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Навигация</h4>
        <nav class="footer-nav">
          <a href="#catalog">Продукция</a>
          <a href="#about">О ферме</a>
          <a href="#how-to-order">Как заказать</a>
        </nav>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Контакты</h4>
        <div class="footer-contacts">
          <a href={`tel:${companyData.phone.replace(/[^0-9+]/g, '')}`} class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            {companyData.phone}
          </a>
          <a href={`mailto:${companyData.email}`} class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            {companyData.email}
          </a>
          <span class="contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {companyData.address}
          </span>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Заказать</h4>
        <p class="footer-order-text">Позвоните или оставьте заявку — мы перезвоним!</p>
        <button class="btn btn-accent" style="width:100%" onclick="window.openLeadForm('')">Оставить заявку</button>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 {companyData.name}. Все права защищены.</p>
      <a href={`${base}privacy`} class="footer-legal-link">Пользовательское соглашение</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-charcoal);
    color: var(--color-cream-dark);
    padding: var(--spacing-3xl) 0 0;
  }

  .footer-top {
    display: grid;
    gap: var(--spacing-2xl);
    padding-bottom: var(--spacing-2xl);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: var(--spacing-xl);
    }
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .footer-logo-leaf {
    font-size: 1.2rem;
  }

  .footer-logo-text {
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--color-sage-light);
  }

  .footer-description {
    font-size: var(--fs-small);
    color: var(--color-earth-light);
    line-height: 1.6;
    max-width: 280px;
    margin: 0;
  }

  /* Columns */
  .footer-heading {
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--color-cream);
    margin-bottom: var(--spacing-sm);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    font-size: var(--fs-small);
    color: var(--color-earth-light);
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: var(--color-sage-light);
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--color-earth-light);
    transition: color var(--transition-fast);
  }

  a.contact-item:hover {
    color: var(--color-sage-light);
  }

  .contact-item svg {
    flex-shrink: 0;
    color: var(--color-sage);
  }

  .footer-order-text {
    font-size: var(--fs-small);
    color: var(--color-earth-light);
    margin-bottom: var(--spacing-sm);
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: var(--fs-xs);
    color: var(--color-earth-light);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal-link {
    color: var(--color-earth-light);
    transition: color var(--transition-fast);
  }

  .footer-legal-link:hover {
    color: var(--color-sage-light);
  }
</style>
