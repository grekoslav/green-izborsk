---
---
<div class="lead-form-wrapper" id="leadFormModal" aria-hidden="true">
  <div class="lead-form-overlay" id="leadFormOverlay"></div>
  <div class="lead-form-modal" id="modalContainer">
    <div class="modal-header">
      <div>
        <h3 class="modal-title">Оставить заявку</h3>
        <p class="modal-subtitle" id="modalSubtitle">Мы перезвоним и обсудим детали заказа</p>
      </div>
      <button class="modal-close" id="leadFormClose" aria-label="Закрыть">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    
    <form class="lead-form" id="orderForm" novalidate>
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
      <input type="hidden" name="productName" id="formProductName" value="">
      <input type="hidden" name="targetEmail" id="formTargetEmail" value="">
      
      <div id="selectedProduct" class="selected-product" style="display:none">
        <span class="selected-label">Продукт:</span>
        <span class="selected-name" id="selectedProductName"></span>
      </div>

      <div class="form-group" id="groupName">
        <label for="name" class="form-label">Ваше имя <span class="required-star">*</span></label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="form-input" 
          placeholder="Как к вам обращаться?"
          aria-describedby="nameError"
          autocomplete="name"
        >
        <span class="form-error" id="nameError" aria-live="polite"></span>
      </div>
      
      <div class="form-group" id="groupPhone">
        <label for="phone" class="form-label">Номер телефона <span class="required-star">*</span></label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          class="form-input" 
          placeholder="+7 (___) ___-__-__" 
          aria-describedby="phoneError"
          autocomplete="tel"
          maxlength="18"
        >
        <span class="form-error" id="phoneError" aria-live="polite"></span>
      </div>

      <div class="form-group">
        <label for="comment" class="form-label">Комментарий <span class="optional">(необязательно)</span></label>
        <textarea id="comment" name="comment" class="form-textarea" placeholder="Что хотите заказать? Укажите объём, пожелания..."></textarea>
      </div>
      
      <div class="form-group" id="groupConsent">
        <label class="form-checkbox-container">
          <input type="checkbox" id="consent" name="consent" class="form-checkbox" aria-describedby="consentError">
          <span>
            Даю согласие на обработку персональных данных 
            (<a href="/privacy" class="privacy-link" target="_blank">соглашение</a>)
          </span>
        </label>
        <span class="form-error" id="consentError" aria-live="polite"></span>
      </div>
      
      <button type="submit" class="btn btn-accent btn-lg form-submit">Отправить заявку</button>
    </form>
    
    <div class="form-success" id="formSuccess" style="display: none;">
      <div class="success-icon">✓</div>
      <h3 class="success-title">Заявка отправлена!</h3>
      <p class="success-text">Мы свяжемся с вами в ближайшее время для уточнения деталей заказа.</p>
      <button class="btn btn-secondary" id="successCloseBtn">Закрыть</button>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      openLeadForm: (productName?: string, productEmail?: string) => void;
    }
  }

  const modal = document.getElementById('leadFormModal');
  const overlay = document.getElementById('leadFormOverlay');
  const closeBtn = document.getElementById('leadFormClose');
  const successCloseBtn = document.getElementById('successCloseBtn');
  const modalContainer = document.getElementById('modalContainer');
  const form = document.getElementById('orderForm') as HTMLFormElement | null;
  const successMsg = document.getElementById('formSuccess');
  const selectedProductEl = document.getElementById('selectedProduct');
  const selectedProductName = document.getElementById('selectedProductName');
  const modalSubtitle = document.getElementById('modalSubtitle');

  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  const consentInput = document.getElementById('consent') as HTMLInputElement | null;

  const nameError = document.getElementById('nameError');
  const phoneError = document.getElementById('phoneError');
  const consentError = document.getElementById('consentError');

  window.openLeadForm = function(productName?: string, productEmail?: string) {
    if (modal) {
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      const inputProd = document.getElementById('formProductName') as HTMLInputElement | null;
      if (inputProd) inputProd.value = productName || '';

      const inputEmail = document.getElementById('formTargetEmail') as HTMLInputElement | null;
      if (inputEmail) inputEmail.value = productEmail || '';

      if (productName && selectedProductEl && selectedProductName) {
        selectedProductEl.style.display = 'flex';
        selectedProductName.textContent = productName;
        if (modalSubtitle) modalSubtitle.textContent = 'Заполните форму — мы перезвоним';
      } else {
        if (selectedProductEl) selectedProductEl.style.display = 'none';
        if (modalSubtitle) modalSubtitle.textContent = 'Мы перезвоним и обсудим детали заказа';
      }

      // Focus name input on open
      setTimeout(() => nameInput?.focus(), 100);
    }
  };

  const clearFormErrors = () => {
    [nameInput, phoneInput, consentInput].forEach(input => {
      input?.classList.remove('is-invalid');
    });
    if (nameError) nameError.textContent = '';
    if (phoneError) phoneError.textContent = '';
    if (consentError) consentError.textContent = '';
  };

  const closeModal = () => {
    if (modal) {
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      clearFormErrors();
      if (form) { 
        form.reset(); 
        form.style.display = 'block'; 
      }
      if (successMsg) successMsg.style.display = 'none';
      if (selectedProductEl) selectedProductEl.style.display = 'none';
    }
  };

  if (overlay) overlay.addEventListener('click', closeModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (successCloseBtn) successCloseBtn.addEventListener('click', closeModal);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.getAttribute('aria-hidden') === 'false') {
      closeModal();
    }
  });

  // ─── Phone Mask & Validation Helper ───
  function formatRussianPhone(val: string): string {
    // Extract raw digits
    let digits = val.replace(/\D/g, '');

    if (!digits) return '';

    // Handle leading digits (8, 7, or 9)
    if (digits.startsWith('8')) {
      digits = '7' + digits.slice(1);
    } else if (!digits.startsWith('7')) {
      digits = '7' + digits;
    }

    // Cap at 11 digits total (+7 + 10 national digits)
    digits = digits.substring(0, 11);

    let result = '+7';
    if (digits.length > 1) {
      result += ' (' + digits.substring(1, Math.min(4, digits.length));
    }
    if (digits.length >= 4) {
      result += ') ' + digits.substring(4, Math.min(7, digits.length));
    }
    if (digits.length >= 7) {
      result += '-' + digits.substring(7, Math.min(9, digits.length));
    }
    if (digits.length >= 9) {
      result += '-' + digits.substring(9, 11);
    }

    return result;
  }

  // Validate Name
  function validateName(): boolean {
    if (!nameInput || !nameError) return true;
    const value = nameInput.value.trim();
    if (!value) {
      nameInput.classList.add('is-invalid');
      nameError.textContent = 'Пожалуйста, укажите ваше имя';
      return false;
    }
    if (value.length < 2) {
      nameInput.classList.add('is-invalid');
      nameError.textContent = 'Имя должно содержать минимум 2 символа';
      return false;
    }
    nameInput.classList.remove('is-invalid');
    nameError.textContent = '';
    return true;
  }

  // Validate Phone
  function validatePhone(): boolean {
    if (!phoneInput || !phoneError) return true;
    const rawVal = phoneInput.value;
    const digits = rawVal.replace(/\D/g, '');

    if (!digits) {
      phoneInput.classList.add('is-invalid');
      phoneError.textContent = 'Пожалуйста, укажите номер телефона';
      return false;
    }

    if (digits.length < 11) {
      phoneInput.classList.add('is-invalid');
      phoneError.textContent = 'Введите полный номер: +7 (XXX) XXX-XX-XX';
      return false;
    }

    // Check operator code (second digit in 11-digit string)
    const operatorCode = digits[1];
    // Valid Russian codes start with 3, 4, 8, 9 (mobile numbers start with 9, landlines 3, 4, 8)
    if (!['3', '4', '8', '9'].includes(operatorCode)) {
      phoneInput.classList.add('is-invalid');
      phoneError.textContent = 'Проверьте код оператора/города (+7 9XX...)';
      return false;
    }

    phoneInput.classList.remove('is-invalid');
    phoneError.textContent = '';
    return true;
  }

  // Validate Consent
  function validateConsent(): boolean {
    if (!consentInput || !consentError) return true;
    if (!consentInput.checked) {
      consentInput.classList.add('is-invalid');
      consentError.textContent = 'Подтвердите согласие на обработку данных';
      return false;
    }
    consentInput.classList.remove('is-invalid');
    consentError.textContent = '';
    return true;
  }

  // Live Phone Input Handling
  if (phoneInput) {
    phoneInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const formatted = formatRussianPhone(target.value);
      target.value = formatted;

      if (phoneInput.classList.contains('is-invalid')) {
        validatePhone();
      }
    });

    phoneInput.addEventListener('blur', () => {
      if (phoneInput.value.length > 0) {
        validatePhone();
      }
    });
  }

  // Live Name Input Handling
  if (nameInput) {
    nameInput.addEventListener('input', () => {
      if (nameInput.classList.contains('is-invalid')) {
        validateName();
      }
    });
    nameInput.addEventListener('blur', () => {
      if (nameInput.value.length > 0) {
        validateName();
      }
    });
  }

  // Live Consent Input Handling
  if (consentInput) {
    consentInput.addEventListener('change', () => {
      if (consentInput.classList.contains('is-invalid')) {
        validateConsent();
      }
    });
  }

  // Form Submit Handler
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const isNameValid = validateName();
      const isPhoneValid = validatePhone();
      const isConsentValid = validateConsent();

      if (!isNameValid || !isPhoneValid || !isConsentValid) {
        if (modalContainer) {
          modalContainer.classList.remove('shake');
          void modalContainer.offsetWidth; // trigger reflow
          modalContainer.classList.add('shake');
        }

        if (!isNameValid) nameInput?.focus();
        else if (!isPhoneValid) phoneInput?.focus();
        else if (!isConsentValid) consentInput?.focus();
        return;
      }

      const submitBtn = form.querySelector('.form-submit') as HTMLButtonElement | null;
      const originalBtnText = submitBtn ? submitBtn.textContent : 'Отправить заявку';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Отправка...';
      }

      try {
        const response = await fetch('/send.php', {
          method: 'POST',
          body: new FormData(form),
        });

        const data = await response.json();
        if (data.success) {
          form.style.display = 'none';
          if (successMsg) successMsg.style.display = 'flex';
        } else {
          alert(data.error || 'Произошла ошибка при отправке заявки.');
        }
      } catch (err) {
        console.error('Ошибка отправки формы:', err);
        alert('Сетевая ошибка при отправке. Пожалуйста, попробуйте еще раз.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          if (originalBtnText) submitBtn.textContent = originalBtnText;
        }
      }
    });
  }
</script>

<style>
  .lead-form-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    visibility: hidden;
    opacity: 0;
    transition: all var(--transition-med);
  }
  
  .lead-form-wrapper[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }
  
  .lead-form-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(46, 42, 38, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  
  .lead-form-modal {
    position: relative;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    background-color: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: 0 20px 60px rgba(46,42,38,0.2);
    z-index: 1001;
    margin: var(--spacing-sm);
    transform: translateY(20px);
    transition: transform var(--transition-med);
  }

  .lead-form-wrapper[aria-hidden="false"] .lead-form-modal {
    transform: translateY(0);
  }
  
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-md);
    gap: 1rem;
  }
  
  .modal-title {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .modal-subtitle {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .modal-close {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
    flex-shrink: 0;
  }

  .modal-close:hover {
    color: var(--color-text);
    background-color: var(--color-border-light);
  }

  /* Selected product */
  .selected-product {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--spacing-md);
    font-size: var(--fs-small);
  }

  .selected-label {
    color: var(--color-text-muted);
  }

  .selected-name {
    font-weight: 600;
    color: var(--color-primary);
  }

  .required-star {
    color: var(--color-error);
    font-weight: 600;
  }

  .form-error {
    display: block;
    color: var(--color-error);
    font-size: var(--fs-xs);
    margin-top: 0.35rem;
    line-height: 1.3;
  }

  .form-input.is-invalid {
    border-color: var(--color-error) !important;
    background-color: rgba(184, 66, 51, 0.03);
    box-shadow: 0 0 0 3px rgba(184, 66, 51, 0.12) !important;
  }

  .form-checkbox.is-invalid {
    outline: 2px solid var(--color-error);
    outline-offset: 1px;
  }

  .lead-form-modal.shake {
    animation: modalShake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes modalShake {
    10%, 90% { transform: translate3d(-2px, 0, 0); }
    20%, 80% { transform: translate3d(4px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
    40%, 60% { transform: translate3d(6px, 0, 0); }
  }

  .optional {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  
  .privacy-link {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy-link:hover {
    color: var(--color-accent);
  }
  
  .form-submit {
    width: 100%;
    margin-top: var(--spacing-xs);
  }
  
  /* Success state */
  .form-success {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-lg) 0;
    gap: var(--spacing-sm);
  }

  .success-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .success-title {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--color-primary);
  }

  .success-text {
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    max-width: 320px;
  }
</style>
